# Lovable Cloud (auto-populated by the integration in .env — do not edit .env)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Required server-side for admin/service-role operations (src/integrations/supabase/client.server.ts)
# and authenticated server-function requests (src/integrations/supabase/auth-middleware.ts).
# Not auto-populated by the Lovable Cloud integration above -- must be set manually for local dev.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
VITE_APP_URL=

# Stripe
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=

# Signs the (user_id, app_id, plan_id) reference threaded through Stripe's
# client_reference_id and PayPal's custom_id (src/lib/payment-reference.server.ts).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_REF_SECRET=

# n8n (src/lib/n8n.server.ts)
N8N_WEBHOOK_URL=

# CORE Notification & User Engagement System -- email delivery
# (src/lib/email.server.ts, Resend). Both required for email to actually
# send; if either is unset, sendEmail() no-ops gracefully (the in-app
# notification still gets created, email_status is recorded as "failed").
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Shared secret an external scheduler (Hostinger cron job, GitHub Actions
# schedule, etc.) presents via the X-Cron-Secret header to invoke the
# 7-day inactivity reminder sweep (src/routes/v1/system/inactivity-sweep.ts).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SYSTEM_CRON_SECRET=

# CORE API /v1 -- RS256 keypair used to mint and verify the unified
# CORE-issued JWT (API_CONTRACT.md -> Authentication & application identity,
# src/lib/v1/jwt.server.ts). Stable across restarts/deployments -- must be
# generated once and kept, never regenerated per boot (a new keypair would
# invalidate every previously-issued token and change the published JWKS).
# V1_JWT_PRIVATE_KEY is the PKCS8 private key PEM, base64-encoded onto one
# line (env vars don't reliably carry embedded newlines). Generate both with:
#   node -e "const {generateKeyPairSync}=require('crypto');const {privateKey,publicKey}=generateKeyPairSync('rsa',{modulusLength:2048});console.log('V1_JWT_PRIVATE_KEY='+privateKey.export({type:'pkcs8',format:'pem'}).toString('base64'));console.log('V1_JWT_KEY_ID='+require('crypto').randomBytes(8).toString('hex'));"
V1_JWT_PRIVATE_KEY=
V1_JWT_KEY_ID=