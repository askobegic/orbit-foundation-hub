# Lovable Cloud (auto-populated by the integration in .env — do not edit .env)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Required server-side for admin/service-role operations (src/integrations/supabase/client.server.ts)
# and authenticated server-function requests (src/integrations/supabase/auth-middleware.ts).
# Not auto-populated by the Lovable Cloud integration above -- must be set manually for local dev.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
VITE_APP_URL=

# Stripe
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=

# Signs the (user_id, app_id, plan_id) reference threaded through Stripe's
# client_reference_id and PayPal's custom_id (src/lib/payment-reference.server.ts).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_REF_SECRET=

# n8n (src/lib/n8n.server.ts)
N8N_WEBHOOK_URL=